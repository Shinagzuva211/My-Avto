# Brauzerga ko'rinadigan (faqat URL manzillari — maxfiy ma'lumot emas)
VITE_API_URL=https://my-avto-backend.onrender.com
VITE_AUTH_API_URL=https://authorization-8nex.onrender.com

# FAQAT SERVER UCHUN. VITE_ prefiksi yo'q — aks holda parol bundle'ga kiritilib ketadi!
# Vercel: Project Settings > Environment Variables ga ham shu uchta o'zgaruvchini qo'shing.
ADMIN_EMAIL=admin@hodiyavto.uz
ADMIN_PASSWORD=change-me
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
